HOST=0.0.0.0
PORT=8000
DEVELOPMENT=true
DEBUG=false

# API Keys
GOOGLE_MAPS_API_KEY=api_key
SESSION_SECRET=your-secret-here-ha

# Database
# Local PostgreSQL, used when DEVELOPMENT=true
DEV_DB_HOST="127.0.0.1"
DEV_DB_PORT=5432
DEV_DB_NAME="crater_spotter"
DEV_DB_USER="postgres"
DEV_DB_PASSWORD=""

# AWS PostgreSQL, used when DEVELOPMENT=false
DB_HOST=""
DB_PORT=5432
DB_NAME=""
DB_USER=""
DB_PASSWORD=""
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=true

# Sequelize pool
DB_POOL_MAX=5
DB_POOL_MIN=0
DB_POOL_ACQUIRE_MS=30000
DB_POOL_IDLE_MS=10000

# Storage
STORAGE_PATH="public/storage/"

# Logging 
